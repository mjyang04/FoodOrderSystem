# === LLM Provider ===
# "anthropic" or "openai" (default: anthropic)
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=              # blank = api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=                 # blank = api.openai.com; supports DeepSeek, Groq, Azure, etc.
OPENAI_MODEL=gpt-4o-mini

# === Database (same vars as fos_api) ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=yourpassword
DB_NAME=food_order_system

# === Service ===
AI_BIND_HOST=127.0.0.1           # WARNING: do NOT set to 0.0.0.0 — breaks trust boundary
AI_BIND_PORT=8000
