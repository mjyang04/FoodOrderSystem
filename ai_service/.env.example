# === LLM Provider ===
# "anthropic" or "openai" (default: anthropic)
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=              # blank = api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=                 # blank = api.openai.com; supports DeepSeek, Groq, Azure, etc.
OPENAI_MODEL=gpt-4o-mini

# === Database (same vars as fos_api) ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=yourpassword
DB_NAME=food_order_system

# === Service ===
AI_BIND_HOST=127.0.0.1           # WARNING: do NOT set to 0.0.0.0 — breaks trust boundary
AI_BIND_PORT=8000

# === Vector DB (Qdrant) ===
# Blank = skip Qdrant; search falls back to BM25-only (still works).
# Set to http://localhost:6333 after `docker compose up -d qdrant` + ingest.
QDRANT_URL=

# === Reranker (bge-reranker-base) ===
# true enables two-stage retrieval; first request downloads ~280MB model.
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base

# === Observability (OpenTelemetry) ===
# Blank = no OTLP exporter (only console span output if TRACING_CONSOLE=true).
# Set to http://localhost:4317 to export to Jaeger/collector on gRPC.
OTLP_ENDPOINT=
TRACING_CONSOLE=true             # print every LLM span to stdout

# === LoRA intent classifier ===
# Blank = FallbackIntentClassifier (few-shot via LlmClient) is used.
# After training (see training/fos_ai_training/intent/model_card.md), set to
# the adapter directory to load LoraIntentClassifier.
INTENT_ADAPTER_PATH=
INTENT_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
